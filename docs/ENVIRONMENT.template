# Bu dosyayı proje köküne .env olarak kopyalayın; gerçek değerleri Git'e eklemeyin.

# Sunucu ve veritabanı
NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
JWT_SECRET=replace-with-a-long-random-secret

# OAuth — yalnızca mevcut OAuth akışını dış sağlayıcıda sürdürmek isterseniz gerekir.
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=

# İsteğe bağlı Manus servisleri. Kullanıcının kendi AI sağlayıcısı akışında kullanılmaz.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# İstemci meta verileri
VITE_APP_TITLE=SmartCourse — AI Learning Designer
VITE_APP_LOGO=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
